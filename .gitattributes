# Normalize line endings so the repo is deterministic across OSes (important for CI).
# Text files are stored with LF in the repo and checked out as LF.
* text=auto eol=lf

# Windows-oriented files keep CRLF
*.sln text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Treat these as binary (never munge line endings / diff)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.dll  binary
*.snk  binary

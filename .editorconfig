# EditorConfig — consistent style across IDEs and CI.  https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ---------------------------------------------------------------------------
# C# conventions
# ---------------------------------------------------------------------------
[*.cs]
indent_size = 4

# Prefer file-scoped namespaces (less nesting, one namespace per file)
csharp_style_namespace_declarations = file_scoped:warning

# 'this.' is redundant noise in this codebase
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion

# Prefer 'var' when the type is apparent, explicit types otherwise
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Modern C# expression preferences
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_prefer_braces = true:suggestion
dotnet_sort_system_directives_first = true

# Naming: interfaces start with I, async methods end with Async (guidance only)
dotnet_naming_rule.interfaces_start_with_i.severity = suggestion

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "applications": {
        "ClusterId": "applications-cluster",
        "Match": { "Path": "/api/job-applications/{**catch-all}" }
      },
      "auth": {
        "ClusterId": "users-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users": {
        "ClusterId": "users-cluster",
        "Match": { "Path": "/api/users/{**catch-all}" }
      }
    },
    "Clusters": {
      "applications-cluster": {
        "Destinations": {
          "primary": { "Address": "http://applications-api:8080/" }
        }
      },
      "users-cluster": {
        "Destinations": {
          "primary": { "Address": "http://users-api:8080/" }
        }
      }
    }
  }
}
